          }

          const descripcion = fila.querySelector('input[type="text"]').value;
          const fechaDesde = fila.querySelectorAll('input[type="date"]')[0].value;
          const fechaHasta = fila.querySelectorAll('input[type="date"]')[1].value;

          const antecedente = {
              id_antecedentes: id_antecedentes,
              descripcion: descripcion,
              fecha_desde: fechaDesde,
              fecha_hasta: fechaHasta
          };

          fetch('/antecedentes/update', {
