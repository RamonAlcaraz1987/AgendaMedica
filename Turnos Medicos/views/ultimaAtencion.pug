      }
                  
            
      
      // Configuración de Quill para cada editor de evoluciones
      document.querySelectorAll('.quill-editor').forEach((element) => {
        const quill = new Quill(element, {
          theme: 'snow',
          placeholder: 'Escribe tu evolución aquí...',
          modules: {
            toolbar: [
              [{ 'header': '1' }, { 'header': '2' }, { 'font': [] }],
              [{ 'list': 'ordered' }, { 'list': 'bullet' }],
              [{ 'align': [] }],
              ['bold', 'italic', 'underline'],
              ['link'],
              ['image'],
              ['clean'] // Para borrar el formato
            ]
          }
        });

        // Puedes almacenar el contenido de Quill como JSON en un campo oculto si es necesario
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = 'descripcion_evolucion'; // Asegúrate de que el nombre corresponda con lo que necesitas
        hiddenInput.value = JSON.stringify(quill.getContents());
        element.parentNode.appendChild(hiddenInput); // Añadir el campo oculto para el envío

      

      });