      }
      function modificarEvolucion(id_evolucion) {
        const editorId = `editor-${id_evolucion}`;
        console.log("Buscando editor con ID:", editorId); // <-- Verificar ID
        
        const editor = document.getElementById(editorId);
        
        if (editor) {
          console.log("Editor encontrado:", editor);

          const quillContent = editor.querySelector('.ql-editor'); 
          const descripcion = quillContent ? quillContent.innerHTML : ''; 
          
          const evolucion = {
            id_evoluciones: id_evolucion,
            descripcion: descripcion
          };

          fetch('/evoluciones/update', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(evolucion),
            
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              
            } else {
              console.error('Error al actualizar la evolución:', data.message);
             
            }
          })
          .catch(error => console.error('Error en la solicitud:', error));
            setTimeout(() => {
              window.location.reload();
            }, 500)
            
            
        } else {
          console.error(`No se encontró el editor para el ID: ${editorId}`);
        }
      }
      function modificarDiagnostico(id_diagnostico) {
          const fila = document.getElementById(`diagnostico-${id_diagnostico}`);
          if (!fila) {
