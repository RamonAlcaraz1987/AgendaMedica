extends layout

block content
  button(onclick="window.history.back()") Volver

  h1 Historial Médico - Última Atención #{fechaAtencion.toLocaleDateString("es-ES", { year: 'numeric', month: 'long', day: 'numeric' })}


  h2 Alergias
    table(border="1", cellpadding="5", cellspacing="0")
      thead
        tr
          th Nombre
          th Fecha Desde
          th Fecha Hasta
          th Acción
      tbody
        each item in alergias
          tr(id=`alergia-${item.id_alergia}`) // Verifica que el ID se genera como esperado
            td
              select(name="nombre")
                each tipoAlergia in tiposAlergias
                  option(value=tipoAlergia.id_nomenclada, selected=tipoAlergia.id_nomenclada == item.id_nomenclada)= tipoAlergia.nombre
            td
              input(type="date", value=item.fecha_desde ? item.fecha_desde : '', style="width: 100%; padding: 10px; font-size: 16px;")
            td
              input(type="date", value=item.fecha_hasta ? item.fecha_hasta : '', style="width: 100%; padding: 10px; font-size: 16px;")
            td
              button(onclick=`eliminarAlergia(${item.id_alergia})`) Eliminar
              button(onclick=`modificarAlergia(${item.id_alergia})`) Actualizar
  
  //- Tabla para Antecedentes
  h2 Antecedentes
    table(border="1", cellpadding="5", cellspacing="0")
      thead
        tr
          th Descripción
          th Fecha Desde
          th Fecha Hasta
          th Acción
      tbody
        each item in antecedentes
          tr(id=`antecedente-${item.id_antecedentes}`)
            td
              input(type="text", value=item.descripcion, style="width: 100%; padding: 10px; font-size: 16px;")
            td
              input(type="date", value=item.fecha_desde || '', style="width: 100%; padding: 10px; font-size: 16px;")
            td
              input(type="date", value=item.fecha_hasta || '', style="width: 100%; padding: 10px; font-size: 16px;")
            td
              button(onclick=`eliminarAntecedente(${item.id_antecedentes})`) Eliminar
              button(onclick=`modificarAntecedente(${item.id_antecedentes})`) Actualizar 
     

  //- Tabla para Medicamentos
  h2 Medicamentos
  table(border="1", cellpadding="5", cellspacing="0")
    thead
      tr
        th Descripción
        th Acción
    tbody
      each item in medicamentos
        tr(id=`medicamento-${item.id_medicamento}`)
          td
            input(type="text", value=item.descripcion, style="width: 100%; padding: 10px; font-size: 16px;")
          td
            button(onclick=`eliminarMedicamento(${item.id_medicamento})`) Eliminar
            button(onclick=`modificarMedicamento(${item.id_medicamento})`) Actualizar

  //- Tabla para Hábitos
  h2 Hábitos
  table(border="1", cellpadding="5", cellspacing="0")
    thead
      tr
        th Descripción
        th Fecha Desde
        th Fecha Hasta
        th Acción
    tbody
      each item in habitos
        tr(id=`habito-${item.id_habito}`)
          td
            input(type="text", value=item.descripcion, style="width: 100%; padding: 10px; font-size: 16px;")
          td
            input(type="date", value=item.fecha_desde || '', style="width: 100%; padding: 10px; font-size: 16px;")
          td
            input(type="date", value=item.fecha_hasta || '', style="width: 100%; padding: 10px; font-size: 16px;")
          td
            button(onclick=`eliminarHabito(${item.id_habito})`) Eliminar
            button(onclick=`modificarHabito(${item.id_habito})`) Actualizar
   

  //- Tabla para Diagnósticos
  h2 Diagnósticos
  table(border="1", cellpadding="5", cellspacing="0")
    thead
      tr
        th Descripción
        th Calidad
        th Acción
    tbody
      each item in diagnosticos
        tr(id=`diagnostico-${item.id_diagnostico}`)
          td
            input(type="text", value=item.descripcion, style="width: 100%; padding: 10px; font-size: 16px;")
          td
            select(name="calidad")
              each tipoDiagnostico in tiposDiagnostico
                option(value=tipoDiagnostico.id_calidad, selected=tipoDiagnostico.id_calidad == item.id_calidad)= tipoDiagnostico.calidad
          if diagnosticos.length > 0
            td
              button(onclick=`eliminarDiagnostico (${item.id_diagnostico})`) Eliminar
              button(onclick=`modificarDiagnostico (${item.id_diagnostico})`) Actualizar
  //- Tabla para Evoluciones con Quill Editor
  h2 Evoluciones
  table(border="1", cellpadding="5", cellspacing="0")
    thead
      tr
        th Descripción
        th Acción
    tbody
      each item in evoluciones
        tr(id=`evolucion-${item.id_evoluciones}`)
          td
            // Asegurarse de que el id esté correctamente formateado
            .quill-editor(id=`editor-${item.id_evoluciones}`, style="width: 100%; min-height: 150px; padding: 10px; font-size: 16px;")!= item.descripcion
          td
            button(onclick=`eliminarEvolucion(${item.id_evoluciones})`) Eliminar
            button(onclick=`modificarEvolucion(${item.id_evoluciones})`) Actualizar
    

  //- Mensaje de actualización
  
  link(rel="stylesheet", href="https://cdn.quilljs.com/1.3.6/quill.snow.css")
  script(src="https://cdn.quilljs.com/1.3.6/quill.min.js")

  block scripts
    script.


      function eliminarAlergia(id) {
        fetch(`/alergias/delete/${id}`, {
          method: 'DELETE',
        })
        setTimeout(() => {
          window.location.reload();
        }, 500)
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            const fila = document.getElementById(`alergia-${id}`);
            fila.remove();
            
          
            
          } else {
            console.error('Error al eliminar la alergia en el servidor');
           
          }
        })
        .catch(error => {
          console.error('Error al intentar eliminar:', error);
          

        });
      }

