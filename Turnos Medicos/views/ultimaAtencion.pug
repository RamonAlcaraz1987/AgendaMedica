      }
      function modificarAlergia(idAlergia) {
          
          const fila = document.getElementById(`alergia-${idAlergia}`);
          if (!fila) {
              console.error(`No se encontró la fila con ID alergia-${idAlergia}`);
              return;
          }

          // Extraer los valores de la fila seleccionada
          const nombre = fila.querySelector('select[name="nombre"]').value;
        
          const fechaDesde = fila.querySelectorAll('input[type="date"]')[0].value;
          const fechaHasta = fila.querySelectorAll('input[type="date"]')[1].value;

          // Crear el objeto con los datos nuevos de la alergia
          const alergia = {
              id_alergia: idAlergia,
              id_nomenclada: nombre,
              fecha_desde: fechaDesde,
              fecha_hasta: fechaHasta
          };

          // Enviar la solicitud de actualización
          fetch('/alergias/update', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json',
              },
              body: JSON.stringify(alergia),
          })
          .then(response => response.json())
          .then(data => {
              if (data.success) {
                  // Cambiar el texto del botón a "¡ACTUALIZADO!" y deshabilitarlo
                  
              } else {
                  console.error('Error al actualizar la alergia:', data.message);
              }
          })
          .catch(error => {
              console.error('Error en la solicitud:', error);
              const botonActualizar = fila.querySelectorAll('button')[1];
              botonActualizar.textContent = '¡ACTUALIZADO!';
              botonActualizar.disabled = true;
          });
      }
      function modificarAntecedente(id_antecedentes) {
          const fila = document.getElementById(`antecedente-${id_antecedentes}`);
          if (!fila) {
